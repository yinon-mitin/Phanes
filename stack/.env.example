# Copy to stack/.env and replace every placeholder locally.
# stack/.env is intentionally ignored by Git.

# Runtime identity used by LinuxServer containers.
TZ=Asia/Jerusalem
PUID=1000
PGID=1000

# Bind every management UI only to the trusted LAN and Tailscale interfaces.
LAN_IP=10.0.0.88
TAILSCALE_IP=100.77.77.77

# Absolute host paths; do not use ~ here.
APPDATA_ROOT=/absolute/path/to/docker/appdata
MEDIA_ROOT=/absolute/path/to/media
DOWNLOADS_ROOT=/absolute/path/to/downloads
JELLYFIN_AUX_CACHE=/absolute/path/to/jellyfin-aux-cache

# Generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-value

# Optional FlareSolverr settings.
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
FLARESOLVERR_PORT=8191
